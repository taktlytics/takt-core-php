{
  "name": "vskstudio/takt-core-php",
  "description": "Framework-agnostic PHP core for Takt analytics: browser snippet renderer + server-to-server event client.",
  "type": "library",
  "license": "MIT",
  "keywords": ["analytics", "takt", "privacy", "tracking", "snippet", "server-to-server"],
  "homepage": "https://github.com/taktlytics/takt-core-php",
  "authors": [{ "name": "vskstudio" }],
  "support": {
    "issues": "https://github.com/taktlytics/takt-core-php/issues",
    "source": "https://github.com/taktlytics/takt-core-php"
  },
  "require": {
    "php": ">=8.1",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "php-http/discovery": "^1.19"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.11",
    "friendsofphp/php-cs-fixer": "^3.59",
    "nyholm/psr7": "^1.8",
    "php-http/mock-client": "^1.6"
  },
  "autoload": { "psr-4": { "Vskstudio\\Takt\\": "src/" } },
  "autoload-dev": { "psr-4": { "Vskstudio\\Takt\\Tests\\": "tests/" } },
  "config": { "allow-plugins": { "php-http/discovery": true } },
  "minimum-stability": "stable"
}
